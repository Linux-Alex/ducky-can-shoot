#!/usr/bin/env python3
"""A stand-in for clamdscan: same as the fake clamscan, plus --fdpass/--ping.

The daemon "connection" is emulated by the DCS_FAKE_CLAMD_DOWN environment
variable: when it is set, --ping fails and DCS must fall back to clamscan.
"""

import os
import sys

# The sibling fake is named "clamscan" without a .py suffix, so it cannot be
# imported by name; load it explicitly from its path instead.
import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402

_SIBLING = os.path.join(os.path.dirname(os.path.abspath(__file__)), "clamscan")
_LOADER = importlib.machinery.SourceFileLoader("dcs_fake_clamscan", _SIBLING)
_SPEC = importlib.util.spec_from_loader(_LOADER.name, _LOADER)
clamscan = importlib.util.module_from_spec(_SPEC)
_LOADER.exec_module(clamscan)


def main(argv: list[str]) -> int:
    if "--ping" in argv or any(arg.startswith("--ping=") for arg in argv):
        if os.environ.get("DCS_FAKE_CLAMD_DOWN"):
            print("ERROR: Could not connect to clamd on 127.0.0.1:3310", file=sys.stderr)
            return 2
        return 0
    return clamscan.main(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
